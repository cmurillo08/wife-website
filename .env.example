# PostgreSQL connection (preferred)
# Either set a full DATABASE_URL (Neon, staging/prod) or the individual PG*
# variables below (local dev). `pg` falls back to the individual PG* vars
# automatically when DATABASE_URL is unset.
# Example DATABASE_URL: postgres://user:pass@localhost:5432/wife_website

# Full connection URL (if set, this takes precedence) — used for Neon
DATABASE_URL=

# Individual Postgres connection parts (local dev, used when DATABASE_URL is unset)
PGHOST=localhost
PGPORT=5432
PGUSER=wife_website_user
PGPASSWORD=change_me
PGDATABASE=personal_projects
# This project's schema is `alexa` in both local dev (sharing the
# `personal_projects` database with sibling projects) and on Neon
# (its own dedicated database, kept on the same schema for parity
# across environments) — set PGSCHEMA=alexa in both places.
PGSCHEMA=alexa

# SSL mode (disable/require). Neon requires SSL — set to `require` there.
PGSSLMODE=disable

# Optional: pin exact pg_dump/psql binaries if a backup/restore script is
# added later. Unset by default.
# PG_DUMP_BIN=/opt/homebrew/opt/postgresql@17/bin/pg_dump
# PSQL_BIN=/opt/homebrew/opt/postgresql@17/bin/psql

# Node environment
NODE_ENV=development

# Authentication (added in Phase 2 — placeholders here so the file is complete from the start)
APP_USERNAME=username
APP_PASSWORD=password
SESSION_SECRET=secret_session_key_change_me

# Image uploads (Vercel Blob) — from the Vercel project's Storage tab
BLOB_READ_WRITE_TOKEN=

# Contact form (added in Phase 3)
RESEND_API_KEY=
